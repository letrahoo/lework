{
  "name": "lework",
  "version": "0.8.4",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash ./scripts/setup.sh",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:kmp": "./app/gradlew -p ./app :shared:jvmTest",
    "stress:ui": "./app/gradlew -p ./app :shared:jvmTest --tests dev.lework.UiAutomationStressTest --rerun-tasks",
    "verify": "pnpm --filter @lework/protocol gen && pnpm -r check && pnpm -r test && ./app/gradlew -p ./app :shared:jvmTest",
    "check": "pnpm -r check",
    "hub": "pnpm --filter @lework/hub start",
    "desktop": "./app/gradlew -p ./app :desktopApp:run",
    "desktop:install": "bash ./scripts/desktop-install.sh",
    "desktop:dmg": "./app/gradlew -p ./app :desktopApp:packageDmg",
    "install:cli": "node ./hub/bin/hub.js install-cli"
  },
  "engines": {
    "node": ">=22"
  }
}
